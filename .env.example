# Скопируйте в .env и заполните значениями

SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# Docker / локально
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/nailis
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:postgres@db:5432/nailis
REDIS_URL=redis://redis:6379/0

LESSON_CACHE_TTL=300
COMPLETION_CACHE_TTL=120
COOKIE_SECURE=false
SAMESITE=lax
LOGIN_ATTEMPTS_LIMIT=5
LOGIN_ATTEMPTS_WINDOW_SECONDS=900
MIN_PASSWORD_LENGTH=8
MAX_VIDEO_UPLOAD_MB=500
ENV=development

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=nailis

SMTP_HOST=smtp.mail.ru
SMTP_PORT=587
SMTP_USER=you@mail.ru
# Для Mail.ru нужен именно «пароль приложения», не обычный пароль входа:
# https://help.mail.ru/mail/security/protection/external
SMTP_PASSWORD=application-password-here
SMTP_TLS=true
EMAIL_FROM=you@mail.ru

CELERY_BROKER_URL=amqp://guest:guest@rabbitmq:5672//
CELERY_RESULT_BACKEND=redis://redis:6379/1
FLOWER_PASSWORD=change-me

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

UID=1000
GID=1000

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-password

# Куда слать заявки «Оставить контакты» (Telegram + email). Временно можно так:
LEADS_NOTIFY_EMAIL=asker_original@mail.ru
